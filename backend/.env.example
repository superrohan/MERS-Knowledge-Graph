NODE_ENV=development
PORT=4000

# Internal Python code-intelligence service (never exposed to the browser).
PYTHON_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_SECRET=dev-internal-secret-change-me

# GitLab integration.
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

WORKSPACE_ROOT=/tmp/code-intelligence-workspaces

# Node's own platform data - users/sessions/applications/repositories -
# in the same Postgres instance the code-intelligence service uses, in
# its own app_*-prefixed tables (code-intelligence/docker/init-node-platform.sql).
DATABASE_URL=postgresql://code_intelligence:code_intelligence@127.0.0.1:5433/code_intelligence

# AES-256-GCM key (32 bytes, hex-encoded = 64 hex characters) a GitLab
# access token is encrypted with before it's ever written to a database
# row. Generate a real one with `openssl rand -hex 32` for any
# environment that isn't a throwaway local dev database - the value
# below is a public, committed placeholder, exactly as insecure as it
# looks.
TOKEN_ENCRYPTION_KEY=8be3428d9e920aaa086e07f79cdf1aa6cd2c62dddea8f8b9f65ad93fd94c0636

# How long a login session stays valid (milliseconds) before it must be
# renewed. Default: 30 days.
SESSION_TTL_MS=2592000000
