HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Must match INTERNAL_SERVICE_SECRET in backend/.env
INTERNAL_SERVICE_SECRET=dev-internal-secret-change-me

WORKSPACE_ROOT=/tmp/code-intelligence-workspaces

# Postgres (Apache AGE for the graph, pgvector for embeddings, plain
# tables for jobs/manifest/chunks). Start it with:
#   docker compose up -d postgres
DATABASE_URL=postgresql://code_intelligence:code_intelligence@127.0.0.1:5433/code_intelligence

# Optional: enables the real OpenAI LLM + embedding providers. Without a
# key, the query engine falls back to a deterministic evidence-based
# answer composer (never a fabricated response), and embeddings fall
# back to a local hashing-based provider (no API call).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
